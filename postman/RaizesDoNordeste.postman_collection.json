{
  "info": {
    "name": "Raízes do Nordeste - API",
    "description": "18 requests. Antes de executar, defina adminSenha como variável secreta de ambiente no Postman. Execute em ordem com servidor local ligado. Não exporte senhas/tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5022"
    },
    {
      "key": "adminEmail",
      "value": "admin@raizesdonordeste.local"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Login Admin",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{adminEmail}}\",\"senha\":\"{{adminSenha}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().accessToken); }"
            ]
          }
        }
      ]
    },
    {
