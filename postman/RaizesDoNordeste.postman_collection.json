            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"unidadeId\":1,\"canalPedido\":\"Web\",\"itens\":[{\"produtoId\":1,\"quantidade\":2},{\"produtoId\":2,\"quantidade\":1}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('pedidoId', String(pm.response.json().id)); }"
            ]
          }
        }
      ]
    },
