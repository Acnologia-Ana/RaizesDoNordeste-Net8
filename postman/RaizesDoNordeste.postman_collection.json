    },
    {
      "name": "08 - Estoque insuficiente (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"unidadeId\": 1,\n  \"canalPedido\": \"Web\",\n  \"itens\": [\n    {\n      \"produtoId\": 1,\n      \"quantidade\": 100\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 - estoque insuficiente', () => pm.response.to.have.status(409));",
              "if (pm.response.code === 409) pm.test('Mensagem especifica', () => pm.expect(pm.response.json().erro).to.include('Estoque insuficiente'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Criar pedido",
      "request": {
        "method": "POST",
