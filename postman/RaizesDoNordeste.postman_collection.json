    {
      "name": "20 - Cadastrar cliente para teste de perfil (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/registrar",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Cliente de Teste Postman\",\n  \"email\": \"{{clienteEmail}}\",\n  \"senha\": \"{{clienteSenha}}\",\n  \"cpf\": null,\n  \"telefone\": null,\n  \"consentimentoFidelidade\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var sufixo=String(Date.now())+Math.floor(Math.random()*10000);",
              "pm.variables.set('clienteEmail','postman.'+sufixo+'@example.com');",
              "pm.variables.set('clienteSenha','Teste@'+sufixo+'!');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 - cliente cadastrado', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { var body=pm.response.json(); pm.test('JWT retornado', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty); pm.collectionVariables.set('clienteToken',body.accessToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "21 - Estoque negado ao Cliente (403)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/estoques?unidadeId=1",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{clienteToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 - Cliente sem permissão', () => pm.response.to.have.status(403));"
            ]
          }
        }
